# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv
venv/

# uv / build caches kept inside the workspace so restricted environments work
.uv-cache/
.uv-python/
.uv-python-cache/
.zig-cache/
.zig-out/

# Local configuration and secrets — never commit these.
# `.env*` also covers backup copies, which is the point: a backup of a file
# holding API keys must not become committable just because its name differs.
.env
.env.*
!.env.example
.credentials.json
settings.json

# Per-project agent state, if a project happens to live in this tree
.surtitle/

# Test and diagnostic scratch
.ci-home/
.testhome/
# Speech models downloaded for a manual end-to-end check. They are large binaries
# and are never part of the repository; `surtitle models download` fetches
# them into the app data directory for normal use.
.local-voice-test/

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
