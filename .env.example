# Surtitle configuration.
#
# Copy this file to `.env` and fill in the two keys. Everything else has a
# sensible default. You can also set keys inside the app (Settings) — those are
# stored separately in the app data directory with owner-only permissions.
#
# Precedence: real environment variables > .env.local > .env > saved settings.

# --- required ----------------------------------------------------------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://console.deepgram.com/  (only needed for voice; see SURTITLE_VOICE)
DEEPGRAM_API_KEY=

# --- model -------------------------------------------------------------------
# deepseek-flash (fast, cheap, default) or deepseek-v4-pro (stronger)
DEEPSEEK_MODEL=deepseek-flash
# minimal | low | medium | high — low keeps spoken turns responsive
SURTITLE_REASONING_EFFORT=low
SURTITLE_THINKING=true
SURTITLE_TEMPERATURE=0.7
SURTITLE_MAX_TOKENS=4096

# --- agent loop --------------------------------------------------------------
# Hard cap on tool-use iterations per turn.
SURTITLE_MAX_STEPS=24
SURTITLE_REQUEST_TIMEOUT=180

# --- voice -------------------------------------------------------------------
# Set false to run text-only (then DEEPGRAM_API_KEY is not required).
SURTITLE_VOICE=true
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en
# How long you must stop talking before your turn is considered finished.
SURTITLE_ENDPOINTING_MS=300
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# 0.5 to 2.0; 1.0 is natural.
SURTITLE_TTS_SPEED=1.0
SURTITLE_TTS_SAMPLE_RATE=24000

# --- server ------------------------------------------------------------------
SURTITLE_HOST=127.0.0.1
SURTITLE_PORT=8765
SURTITLE_OPEN_BROWSER=true
SURTITLE_LOG_LEVEL=info

# --- storage -----------------------------------------------------------------
# Defaults to ~/Library/Application Support/Surtitle on macOS and
# %LOCALAPPDATA%\Surtitle on Windows. Uncomment to relocate.
# SURTITLE_HOME=
