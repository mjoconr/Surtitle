# Surtitle configuration.
#
# Copy this file to `.env` and fill in the two keys. Everything else has a
# sensible default. You can also set keys inside the app (Settings) — those are
# stored separately in the app data directory with owner-only permissions.
#
# Precedence: real environment variables > .env.local > .env > saved settings.

# --- required ----------------------------------------------------------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://console.deepgram.com/  (only needed for voice; see SURTITLE_VOICE)
DEEPGRAM_API_KEY=

# --- model -------------------------------------------------------------------
# deepseek-flash (fast, cheap, default) or deepseek-v4-pro (stronger)
DEEPSEEK_MODEL=deepseek-flash
# minimal | low | medium | high — low keeps spoken turns responsive
SURTITLE_REASONING_EFFORT=low
SURTITLE_THINKING=true
SURTITLE_TEMPERATURE=0.7
SURTITLE_MAX_TOKENS=4096

# --- agent loop --------------------------------------------------------------
# Hard cap on tool-use iterations per turn.
SURTITLE_MAX_STEPS=24
SURTITLE_REQUEST_TIMEOUT=180

# --- voice -------------------------------------------------------------------
# Set false to run text-only (then DEEPGRAM_API_KEY is not required).
SURTITLE_VOICE=true

# Which engine each direction uses:
#   deepgram = hosted streaming service (default; needs DEEPGRAM_API_KEY)
#   local    = sherpa-onnx in this process; no key, no network, no cost
# They are independent, so "local ears with a hosted voice" is a valid setting.
# Local needs a one-time model download: `surtitle models download`
# (see the "local voice" section below).
SURTITLE_STT_BACKEND=deepgram
SURTITLE_TTS_BACKEND=deepgram

# Which streaming API to use on the Deepgram backend:
#   v2 = Flux. Contextual end-of-turn detection, which uses what you said rather
#        than a silence timer. This is the default and gives the best
#        conversational feel.
#   v1 = Nova with endpointing. Use it if Flux is unavailable on your account.
SURTITLE_STT_API=v2

# Flux model. Flux takes a much smaller parameter set than Nova and ignores
# SURTITLE_ENDPOINTING_MS entirely.
DEEPGRAM_STT_MODEL=flux-general-en

# Optional Flux end-of-turn tuning. Leave unset for the service defaults.
# How confident the model must be that you have finished (higher waits longer).
# SURTITLE_EOT_THRESHOLD=0.7
# Ceiling on how long a turn stays open, in milliseconds.
# SURTITLE_EOT_TIMEOUT_MS=5000

# --- v1 (Nova) only ----------------------------------------------------------
DEEPGRAM_STT_LANGUAGE=en
# How long you must stop talking before your turn is considered finished.
SURTITLE_ENDPOINTING_MS=300
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# 0.5 to 2.0; 1.0 is natural.
SURTITLE_TTS_SPEED=1.0
SURTITLE_TTS_SAMPLE_RATE=24000

# --- local voice (SURTITLE_STT_BACKEND/TTS_BACKEND=local) ----------------
# Requires the extra: `uv sync --extra voice-local` (or pip install
# 'surtitle[voice-local]'), then `surtitle models download`.
# Everything runs on the CPU, offline. Models are cached under the app data
# directory and are never downloaded automatically.

# Larger is more accurate and slower to load. Run `surtitle models list`.
SURTITLE_LOCAL_STT_MODEL=streaming-zipformer-en-2023-06-26
SURTITLE_LOCAL_TTS_MODEL=vits-piper-en_US-lessac-medium
# Prefer the int8 (half-size) encoder when the model ships one.
SURTITLE_LOCAL_STT_INT8=true

# Turn detection. A local model has no contextual end-of-turn detector, so a
# turn ends after this much silence — extended to the second value when the
# transcript ends in a word like "and" or "the", and forced at the ceiling.
SURTITLE_LOCAL_EOT_SILENCE_MS=800
SURTITLE_LOCAL_EOT_EXTEND_MS=1200
SURTITLE_LOCAL_MAX_UTTERANCE_MS=20000

# Where models live. Defaults to <data dir>/models. Models survive an update,
# so this is worth putting somewhere with room (about 90 MB for both).
# SURTITLE_MODELS_DIR=

# --- server ------------------------------------------------------------------
SURTITLE_HOST=127.0.0.1
SURTITLE_PORT=8765
SURTITLE_OPEN_BROWSER=true
SURTITLE_LOG_LEVEL=info

# --- storage -----------------------------------------------------------------
# Defaults to ~/Library/Application Support/Surtitle on macOS and
# %LOCALAPPDATA%\Surtitle on Windows. Uncomment to relocate.
# SURTITLE_HOME=
